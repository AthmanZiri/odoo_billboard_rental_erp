<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_message_transfer_search" model="ir.ui.view">
        <field name="name">mail.message.search.transfer.history</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
            <search string="Transfer history">
                <field name="body" string="Details"/>
                <field name="author_id"/>
                <field name="record_name" string="Face"/>
                <field name="date"/>
            </search>
        </field>
    </record>

    <record id="view_mail_message_face_transfer_list" model="ir.ui.view">
        <field name="name">mail.message.list.face.transfer.history</field>
        <field name="model">mail.message</field>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <list string="Transfer history" create="0" delete="0" edit="0" default_order="date desc">
                <header>
                    <button name="%(media_finance.action_media_booking_transfer)d" type="action" string="New transfer" class="btn-primary"/>
                </header>
                <field name="date"/>
                <field name="record_name" string="Face"/>
                <field name="author_id" string="User"/>
                <field name="subtype_id" optional="hide"/>
                <field name="body" string="Details" widget="html" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_media_transfer_history" model="ir.actions.act_window">
        <field name="name">Transfer booking</field>
        <field name="res_model">mail.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mail_message_transfer_search"/>
        <field name="view_id" ref="view_mail_message_face_transfer_list"/>
        <field name="domain" eval="[('model', '=', 'media.face'), ('subtype_id', '=', ref('media_finance.mt_media_face_booking_transfer'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transfer events yet</p>
            <p>Completed booking moves appear here. Click <b>New transfer</b> (above) or <b>Start transfer</b> under Operations to run a new transfer.</p>
        </field>
    </record>

    <record id="view_media_face_form_inherit_transfer_history" model="ir.ui.view">
        <field name="name">media.face.form.inherit.transfer.history</field>
        <field name="model">media.face</field>
        <field name="inherit_id" ref="media_inventory.view_media_face_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transfer_history" type="object"
                        class="oe_stat_button" icon="fa-exchange">
                    <field name="transfer_history_count" widget="statinfo" string="Transfers"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
