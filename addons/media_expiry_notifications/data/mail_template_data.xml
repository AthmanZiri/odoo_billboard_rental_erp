<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="asset_expiry_notification_template" model="mail.template">
            <field name="name">Media Asset Expiry Notification</field>
            <field name="subject">Expiry Alert: {{ ctx.get('ctx_asset_name') }}</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ object.company_id.email or user.email }}&gt;</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.name" />,<br /><br />
        This is an automated notification that the <strong t-out="ctx.get('ctx_asset_type')"/> 
        named <strong t-out="ctx.get('ctx_asset_name')"/> is set to expire on <strong t-out="ctx.get('ctx_end_date')"/>.<br /><br />
        Please review the active booking and take appropriate action.
        <br /><br />
        Thanks,<br />
        <t t-out="object.company_id.name" />
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
