<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_notify_expiring_faces" model="ir.cron">
            <field name="name">Media Assets: Notify Expiring Faces</field>
            <field name="model_id" ref="media_inventory.model_media_face"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_expiring_faces()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_notify_expiring_slots" model="ir.cron">
            <field name="name">Media Assets: Notify Expiring Slots</field>
            <field name="model_id" ref="media_dooh.model_media_dooh_slot"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_expiring_slots()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_notify_expiring_canopies" model="ir.cron">
            <field name="name">Media Assets: Notify Expiring Canopies</field>
            <field name="model_id" ref="media_inventory.model_media_canopy"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_expiring_canopies()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
