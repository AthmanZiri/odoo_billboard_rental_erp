<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_relink_canopy_from_face_lines" model="ir.actions.server">
        <field name="name">Link to canopy site from face</field>
        <field name="model_id" ref="model_media_artwork_history"/>
        <field name="binding_model_id" ref="model_media_artwork_history"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_relink_canopy_site_from_face()
        </field>
    </record>

    <record id="action_server_relink_all_orphan_canopy_sites" model="ir.actions.server">
        <field name="name">Link all orphan canopy renovations (from faces)</field>
        <field name="model_id" ref="model_media_artwork_history"/>
        <field name="state">code</field>
        <field name="code">
action = env['media.artwork.history'].action_relink_all_orphan_canopy_sites()
        </field>
    </record>

    <!-- Form button: Odoo 18+ may reject type="object" for some methods on delegated models. -->
    <record id="action_server_relink_historical_canopy_form" model="ir.actions.server">
        <field name="name">Link old canopy renovation lines</field>
        <field name="model_id" ref="model_media_canopy"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_relink_historical_renovations_for_canopy()
        </field>
    </record>
</odoo>
