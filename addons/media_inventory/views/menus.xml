<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Load before menuitem below so action xmlid exists (same issue as relink on canopy form). -->
    <record id="action_server_relink_all_orphan_canopy_sites" model="ir.actions.server">
        <field name="name">Link all orphan canopy renovations (from faces)</field>
        <field name="model_id" ref="model_media_artwork_history"/>
        <field name="state">code</field>
        <field name="code">
action = env['media.artwork.history'].action_relink_all_orphan_canopy_sites()
        </field>
    </record>

    <menuitem id="menu_media_root" name="Billboard System" web_icon="media_inventory,static/description/icon.png"/>

    <!-- 1) Dashboard -->
    <menuitem id="menu_billboard_dashboard" name="Dashboard" parent="menu_media_root" sequence="1"/>

    <!-- 2) Billboards -->
    <menuitem id="menu_billboard_billboards" name="Billboards" parent="menu_media_root" sequence="10"/>
    <menuitem id="menu_media_site" name="Billboard Assets" parent="menu_billboard_billboards" action="action_media_billboard" sequence="10"/>
    <menuitem id="menu_media_face_list" name="Billboard Faces" parent="menu_billboard_billboards" action="action_media_face" sequence="20"/>
    <menuitem id="menu_billboard_images" name="Billboard Artwork" parent="menu_billboard_billboards" action="action_media_artwork_billboard" sequence="40"/>


    <!-- 3) Digital Screens -->
    <menuitem id="menu_digital_root" name="Digital Screens" parent="menu_media_root" sequence="20"/>
    <menuitem id="menu_digital_screen_list" name="Digital Screens" parent="menu_digital_root" action="action_media_digital_screen_v2" sequence="5"/>

    <!-- 4) Canopies -->
    <menuitem id="menu_canopy_root" name="Canopies" parent="menu_media_root" sequence="30"/>
    <menuitem id="menu_canopy_list" name="Canopy Assets" parent="menu_canopy_root" action="action_media_canopy" sequence="10"/>
    <menuitem id="menu_canopy_list_all" name="All Canopies (incl. inactive)" parent="menu_canopy_root" action="action_media_canopy_all" sequence="11"/>
    <menuitem id="menu_canopy_artwork" name="Canopy Renovations" parent="menu_canopy_root" action="action_media_artwork_canopy" sequence="20"/>
    <menuitem id="menu_canopy_update_status" name="Update Canopy Status" parent="menu_canopy_root" action="action_canopy_status_wizard" sequence="40"/>

    <!-- 5) Operations -->
    <menuitem id="menu_media_ops" name="Operations" parent="menu_media_root" sequence="40"/>
    <menuitem id="menu_ops_sale_orders" name="Sale Orders" parent="menu_media_ops" action="sale.action_orders" sequence="10"/>
    <menuitem id="menu_ops_invoices" name="Invoices" parent="menu_media_ops" action="account.action_move_out_invoice_type" sequence="20"/>
    <menuitem id="menu_ops_payments" name="Payments" parent="menu_media_ops" action="account.action_account_payments" sequence="30"/>
    <menuitem id="menu_media_expense" name="Expenses" parent="menu_media_ops" action="action_media_expense" sequence="40"/>
    
    <record id="action_media_permit_history" model="ir.actions.act_window">
        <field name="name">Permit History</field>
        <field name="res_model">media.permit.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ops_permits" name="Permits" parent="menu_media_ops" action="action_media_permit_history" sequence="70"/>

    <!-- 6) Maps -->
    <menuitem id="menu_media_maps_root" name="Maps" parent="menu_media_root" sequence="50"/>
    <menuitem id="menu_media_billboard_map" name="Billboard Map" parent="menu_media_maps_root" action="action_media_billboard_map" sequence="10"/>
    <menuitem id="menu_media_face_map" name="Billboard Faces Map" parent="menu_media_maps_root" action="action_media_face_map" sequence="15"/>
    <menuitem id="menu_media_canopy_map" name="Canopy Map" parent="menu_media_maps_root" action="action_media_canopy_map" sequence="20"/>
    <menuitem id="menu_media_digital_screen_map" name="Digital Screen Map" parent="menu_media_maps_root" action="action_media_digital_screen_map" sequence="30"/>

    <!-- 7) Reports -->
    <menuitem id="menu_media_reports_root" name="Reports" parent="menu_media_root" sequence="60"/>
    <menuitem id="menu_media_report_all" name="All Assets" parent="menu_media_reports_root" action="action_media_face" sequence="10"/>
    <menuitem id="menu_media_report_rentals" name="All Rentals" parent="menu_media_reports_root" action="sale.action_order_report_all" sequence="20"/>
    <menuitem id="menu_media_report_available" name="Available Assets" parent="menu_media_reports_root" action="action_media_face_available" sequence="30"/>
    <menuitem id="menu_media_report_reserved" name="Reserved Assets" parent="menu_media_reports_root" action="action_media_face_reserved" sequence="40"/>
    <menuitem id="menu_media_report_soon" name="Available in 1 Month" parent="menu_media_reports_root" action="action_media_face_soon" sequence="50"/>
    <menuitem id="menu_media_report_available_14" name="Available in 2 Weeks" parent="menu_media_reports_root" action="action_media_face_available_14" sequence="55"/>
    <menuitem id="menu_media_report_available_7" name="Available in 1 Week" parent="menu_media_reports_root" action="action_media_face_available_7" sequence="57"/>
    <menuitem id="menu_media_report_available_2" name="Available in 2 Days" parent="menu_media_reports_root" action="action_media_face_available_2" sequence="58"/>
    <menuitem id="menu_media_report_expired" name="Expired Assets" parent="menu_media_reports_root" action="action_media_face_expired" sequence="60"/>
    <menuitem id="menu_media_report_canopy" name="Canopy Reports" parent="menu_media_reports_root" action="action_media_canopy" sequence="70"/>

    <!-- 8) Configuration -->
    <menuitem id="menu_media_config" name="Configuration" parent="menu_media_root" sequence="100"/>
    <menuitem id="menu_relink_orphan_canopy_sites" name="Link orphan renovation sites" parent="menu_media_config" action="action_server_relink_all_orphan_canopy_sites" groups="base.group_system" sequence="5"/>
    <menuitem id="menu_media_location" name="Locations" parent="menu_media_config" sequence="10"/>
    <menuitem id="menu_media_county" name="Counties" parent="menu_media_location" action="action_media_county" sequence="10"/>
    <menuitem id="menu_media_sub_county" name="Sub-Counties" parent="menu_media_location" action="action_media_sub_county" sequence="20"/>
</odoo>
